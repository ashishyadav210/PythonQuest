# PythonQuest - cPanel/Apache friendly static hosting
DirectoryIndex index.html
Options -Indexes

<IfModule mod_authz_core.c>
    Require all granted
</IfModule>
<IfModule mod_access_compat.c>
    Order allow,deny
    Allow from all
</IfModule>

# This is a single-page app; send unknown browser routes to index.html.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>
